{%- comment -%}
  Vista JSON para el Mirea Skin Advisor.
  Se pide con /collections/<handle>?view=advisor y devuelve hasta 250 productos
  disponibles de esa colección, con el paso de rutina, los tipos de piel y los
  objetivos que ya tiene asignados en la tienda. No inventa nada: todo sale de
  las colecciones a las que pertenece cada producto.
{%- endcomment -%}
{%- layout none -%}
{%- liquid
  assign pasos = 'limpiar,tratar,hidratar,proteger' | split: ','
  assign pieles = 'piel-seca,piel-grasa,piel-mixta,piel-sensible' | split: ','
  assign objetivos = 'granitos,poros,manchas,barrera-cutanea,calma-y-rojeces,antiedad' | split: ','
-%}
{%- paginate collection.products by 250 -%}
{"handle":{{ collection.handle | json }},"titulo":{{ collection.title | json }},"total":{{ collection.all_products_count }},"productos":[
{%- assign sep = '' -%}
{%- for p in collection.products -%}
  {%- if p.available -%}
    {%- assign paso = '' -%}
    {%- assign pielesProducto = '' -%}
    {%- assign objetivosProducto = '' -%}
    {%- assign esCuerpo = false -%}
    {%- for c in p.collections -%}
      {%- if c.handle == 'cuerpo' -%}{%- assign esCuerpo = true -%}{%- endif -%}
      {%- if pasos contains c.handle -%}
        {%- if paso == '' -%}{%- assign paso = c.handle -%}{%- endif -%}
      {%- endif -%}
      {%- if pieles contains c.handle -%}{%- assign pielesProducto = pielesProducto | append: c.handle | append: ' ' -%}{%- endif -%}
      {%- if objetivos contains c.handle -%}{%- assign objetivosProducto = objetivosProducto | append: c.handle | append: ' ' -%}{%- endif -%}
    {%- endfor -%}
    {%- unless paso == '' or esCuerpo -%}
      {{ sep }}{"t":{{ p.title | json }},"u":{{ p.url | json }},"p":{{ p.price }},"i":{{ p.featured_image | image_url: width: 360 | json }},"s":{{ paso | json }},"k":{{ pielesProducto | strip | json }},"o":{{ objetivosProducto | strip | json }},"v":{{ p.vendor | json }}}
      {%- assign sep = ',' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
]}
{%- endpaginate -%}
