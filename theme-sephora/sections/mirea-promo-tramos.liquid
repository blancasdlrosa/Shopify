{%- comment -%} 15-10 Mirea: portada de beneficios por tramos (idea Sephora "Gold Day"): 3 bloques oscuros con lo que gana la clienta al subir el carrito + foto + botón. Solo beneficios reales. {%- endcomment -%}
<section class="mpt" id="mpt-{{ section.id }}">
  <div class="mpt__wrap">
    <div class="mpt__tramos">
      {%- for block in section.blocks -%}
        <a class="mpt__tramo" href="{{ block.settings.enlace | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <span class="mpt__big">{{ block.settings.grande }}</span>
          <span class="mpt__txt">{{ block.settings.texto }}</span>
          {%- if block.settings.pie != blank -%}<span class="mpt__pie">{{ block.settings.pie }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <div class="mpt__foto">
      {%- if section.settings.imagen != blank -%}
        {{ section.settings.imagen | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.titulo }}
      {%- endif -%}
    </div>
    <div class="mpt__copy">
      <p class="mpt__ante">{{ section.settings.antetitulo }}</p>
      <h2 class="mpt__tit">{{ section.settings.titulo }}</h2>
      <p class="mpt__desc">{{ section.settings.texto }}</p>
      <a class="mpt__btn" href="{{ section.settings.enlace | default: '/collections/all' }}">{{ section.settings.boton }}</a>
      {%- if section.settings.nota != blank -%}<p class="mpt__nota">{{ section.settings.nota }}</p>{%- endif -%}
    </div>
  </div>
</section>
<style>
#mpt-{{ section.id }}{background:#fff;color:#1f191c;padding:40px 0}
#mpt-{{ section.id }} *{box-sizing:border-box}
#mpt-{{ section.id }} .mpt__wrap{width:min(calc(100% - 32px),1280px);margin:0 auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr) minmax(0,.95fr);gap:24px;align-items:center;background:#f8efec;border-radius:4px;padding:32px}
#mpt-{{ section.id }} .mpt__tramos{display:grid;grid-template-columns:1fr 1fr;gap:12px}
#mpt-{{ section.id }} .mpt__tramo{display:flex;flex-direction:column;gap:6px;background:#1f191c;color:#fff;text-decoration:none;padding:20px 18px;min-height:170px;transition:transform .2s ease}
#mpt-{{ section.id }} .mpt__tramo:hover{transform:translateY(-3px)}
#mpt-{{ section.id }} .mpt__tramo:nth-child(3){grid-column:1/2}
#mpt-{{ section.id }} .mpt__big{font-family:var(--font-heading--family);font-size:clamp(34px,3.6vw,54px);line-height:.95;font-weight:500}
#mpt-{{ section.id }} .mpt__txt{font-size:15px;line-height:1.35}
#mpt-{{ section.id }} .mpt__pie{margin-top:auto;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#e9c9d3}
#mpt-{{ section.id }} .mpt__foto{align-self:stretch;min-height:420px;position:relative;overflow:hidden}
#mpt-{{ section.id }} .mpt__foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#mpt-{{ section.id }} .mpt__ante{margin:0 0 10px;color:#925b6d;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
#mpt-{{ section.id }} .mpt__tit{margin:0;font-size:clamp(34px,3.6vw,52px);line-height:1.02}
#mpt-{{ section.id }} .mpt__desc{margin:14px 0 22px;font-size:16px;line-height:1.55;color:#4d4045}
#mpt-{{ section.id }} .mpt__btn{display:block;text-align:center;border:2px solid #1f191c;border-radius:6px;padding:15px 20px;color:#1f191c;font-weight:700;font-size:15px;text-decoration:none;background:#fff}
#mpt-{{ section.id }} .mpt__btn:hover{background:#1f191c;color:#fff}
#mpt-{{ section.id }} .mpt__nota{margin:14px 0 0;font-size:12px;color:#715b63;line-height:1.5}
@media(max-width:989px){
  #mpt-{{ section.id }} .mpt__wrap{grid-template-columns:1fr;padding:18px}
  #mpt-{{ section.id }} .mpt__foto{min-height:320px;order:-1}
}
@media(max-width:560px){
  #mpt-{{ section.id }}{padding:20px 0}
  #mpt-{{ section.id }} .mpt__tramo{min-height:140px;padding:16px 14px}
  #mpt-{{ section.id }} .mpt__big{font-size:34px}
  #mpt-{{ section.id }} .mpt__txt{font-size:13px}
}
</style>
{% schema %}
{"name":"Mirea · Tramos regalo","tag":"section","settings":[
{"type":"image_picker","id":"imagen","label":"Foto"},
{"type":"text","id":"antetitulo","label":"Antetítulo","default":"Regalos Mirea"},
{"type":"text","id":"titulo","label":"Título","default":"Cuanto más cuidas tu piel, más te llevas."},
{"type":"textarea","id":"texto","label":"Texto","default":"Sin códigos: se aplica solo en tu pedido."},
{"type":"text","id":"boton","label":"Botón","default":"Comprar"},
{"type":"url","id":"enlace","label":"Enlace del botón"},
{"type":"text","id":"nota","label":"Nota pequeña","default":"*Envío gratis en España en tarifas elegibles. Guía y journal digitales, en tu primer pedido."}
],
"blocks":[{"type":"tramo","name":"Tramo","limit":4,"settings":[
{"type":"text","id":"grande","label":"Texto grande","default":"+35 €"},
{"type":"text","id":"texto","label":"Texto","default":"Guía Mirea PRO de regalo"},
{"type":"text","id":"pie","label":"Pie","default":"Primer pedido"},
{"type":"url","id":"enlace","label":"Enlace"}]}],
"presets":[{"name":"Mirea · Tramos regalo"}]}
{% endschema %}
