{%- comment -%} 15-10 Mirea: "Mucho más que productos" (idea Sephora "Un mundo lleno de experiencias"): tarjetas horizontales con foto a la izquierda. Si no hay foto, usa la del producto elegido. {%- endcomment -%}
<section class="mxc" id="mxc-{{ section.id }}">
  <div class="mxc__wrap">
    <h2>{{ section.settings.titulo }}</h2>
    <div class="mxc__grid">
      {%- for block in section.blocks -%}
        <a class="mxc__card" href="{{ block.settings.enlace | default: '/' }}" {{ block.shopify_attributes }}>
          <span class="mxc__img">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.titulo }}
            {%- elsif block.settings.producto.featured_image -%}
              {{ block.settings.producto.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.titulo }}
            {%- endif -%}
          </span>
          <span class="mxc__txt"><strong>{{ block.settings.titulo }}</strong><span>{{ block.settings.texto }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#mxc-{{ section.id }}{background:#fff;color:#1f191c;padding:48px 0}
#mxc-{{ section.id }} *{box-sizing:border-box}
#mxc-{{ section.id }} .mxc__wrap{width:min(calc(100% - 32px),1280px);margin:0 auto}
#mxc-{{ section.id }} h2{margin:0 0 24px;font-size:clamp(32px,3.6vw,50px);line-height:1.02}
#mxc-{{ section.id }} .mxc__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
#mxc-{{ section.id }} .mxc__card{display:grid;grid-template-columns:38% 1fr;min-height:150px;border:1px solid #e8dcd8;border-radius:6px;overflow:hidden;color:#1f191c;text-decoration:none;background:#fff;transition:box-shadow .2s}
#mxc-{{ section.id }} .mxc__card:hover{box-shadow:0 10px 26px rgba(31,25,28,.08)}
#mxc-{{ section.id }} .mxc__img{position:relative;background:#f6eeeb}
#mxc-{{ section.id }} .mxc__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#mxc-{{ section.id }} .mxc__txt{display:flex;flex-direction:column;justify-content:center;gap:6px;padding:16px}
#mxc-{{ section.id }} .mxc__txt strong{font-size:16px;line-height:1.2}
#mxc-{{ section.id }} .mxc__txt span{font-size:13.5px;line-height:1.45;color:#4d4045}
@media(max-width:989px){#mxc-{{ section.id }} .mxc__grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){#mxc-{{ section.id }} .mxc__grid{grid-template-columns:1fr}}
</style>
{% schema %}
{"name":"Mirea · Experiencias","tag":"section","settings":[
{"type":"text","id":"titulo","label":"Título","default":"Mucho más que productos"}],
"blocks":[{"type":"tarjeta","name":"Tarjeta","limit":8,"settings":[
{"type":"image_picker","id":"imagen","label":"Foto (opcional)"},
{"type":"product","id":"producto","label":"O foto de este producto"},
{"type":"text","id":"titulo","label":"Título","default":"Mirea AI"},
{"type":"textarea","id":"texto","label":"Texto"},
{"type":"url","id":"enlace","label":"Enlace"}]}],
"presets":[{"name":"Mirea · Experiencias"}]}
{% endschema %}
