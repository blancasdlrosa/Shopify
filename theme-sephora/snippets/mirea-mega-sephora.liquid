{%- comment -%}
  Mirea v9 · Mega menú tipo Sephora (solo escritorio). Se usa para "Piel" y "Marcas" del menú principal.
  15-10: añadido kind 'visual' y 'espana'. 16-10: sin emojis (siempre foto, snippet mirea-mega-tile), Todo agrupado, Corea y España separados.
  Lee los enlaces del propio menú (Tienda online → Navegación), así que si Blanca cambia el menú, esto cambia solo.
  Fotos: usa SOLO la imagen existente de cada colección (o la del primer producto si la colección no tiene). No añade fotos nuevas.
  @param parent_link, id, kind ('piel' | 'marcas' | 'visual' | 'espana')
{%- endcomment -%}
{%- liquid
  assign marcas_link = linklists['main-menu'].links | where: 'title', 'Marcas' | first
-%}
<ul data-menu-list-id="{{ id }}" class="mega-menu__list list-unstyled msm">
  <li class="msm__inner{% if kind == 'visual' or kind == 'espana' %} msm__inner--vis{% endif %}">
    {%- if kind == 'piel' -%}
      {%- assign needs = parent_link.links | where: 'title', 'Por necesidad' | first -%}
      {%- assign tipos = parent_link.links | where: 'title', 'Por tipo de piel' | first -%}
      <div class="msm__col">
        <p class="msm__h">Categorías</p>
        <ul class="list-unstyled msm__list">
          {%- for l in parent_link.links -%}
            {%- if l.links == blank -%}
              <li><a class="msm__a" href="{{ l.object.url | default: l.url }}">{{ l.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          <li><a class="msm__a msm__a--all" href="{{ parent_link.object.url | default: parent_link.url }}">Ver todo Piel →</a></li>
        </ul>
      </div>
      {%- for grupo in (1..2) -%}
        {%- if grupo == 1 -%}{%- assign g = needs -%}{%- assign gt = 'Por necesidad' -%}{%- else -%}{%- assign g = tipos -%}{%- assign gt = 'Tipo de piel' -%}{%- endif -%}
        {%- if g -%}
          <div class="msm__col">
            <p class="msm__h">{{ gt }}</p>
            <ul class="list-unstyled msm__list msm__list--img">
              {%- for l in g.links -%}
                {%- liquid
                  assign img = blank
                  if l.object.image
                    assign img = l.object.image
                  elsif l.object.products.first.featured_image
                    assign img = l.object.products.first.featured_image
                  endif
                -%}
                <li>
                  <a class="msm__ia" href="{{ l.object.url | default: l.url }}">
                    <span class="msm__thumb">{%- if img != blank -%}{{ img | image_url: width: 120 | image_tag: loading: 'lazy', alt: l.title, width: 44, height: 44 }}{%- endif -%}</span>
                    <span>{{ l.title }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if marcas_link -%}
        <div class="msm__col">
          <p class="msm__h">Marcas top</p>
          <ul class="list-unstyled msm__list">
            {%- for l in marcas_link.links limit: 11 -%}
              {%- unless forloop.first -%}<li><a class="msm__a" href="{{ l.object.url | default: l.url }}">{{ l.title }}</a></li>{%- endunless -%}
            {%- endfor -%}
            <li><a class="msm__a msm__a--all" href="{{ marcas_link.object.url | default: marcas_link.url }}">Todas las marcas →</a></li>
          </ul>
        </div>
      {%- endif -%}
      <div class="msm__promo">
        <a class="msm__card msm__card--dark" href="/pages/encuentra-tu-rutina">
          <span class="msm__eyebrow">Asesoría gratis</span>
          <span class="msm__title">Encuentra tu rutina</span>
          <span class="msm__txt">Responde unas preguntas sobre tu piel y te proponemos una rutina coreana paso a paso.</span>
          <span class="msm__btn">Hacer el test</span>
        </a>
        <a class="msm__card" href="/pages/la-guia">
          <span class="msm__eyebrow">Regalo Mirea</span>
          <span class="msm__title msm__title--sm">Guía PDF de regalo</span>
          <span class="msm__txt">En tu primer pedido desde 35 € · rutinas + journal desde 60 € · envío gratis en España desde 69 €.</span>
        </a>
      </div>
    {%- elsif kind == 'visual' -%}
      {%- comment -%}
        16-10: menú visual sin dibujos.
        · "Todo": agrupado con títulos (Comprar por / Por origen / Especial Mirea / Te ayudamos).
        · Categorías: lo de Corea y lo de España por separado (según la etiqueta "Envío: Corea" / "Envío: España" de los productos).
        · Resto: rejilla simple.
      {%- endcomment -%}
      {%- liquid
        assign es_map = 'Cabello::desde-espana-cabello|Cuerpo::desde-espana-cuerpo|Maquillaje::desde-espana-maquillaje|Aparatos y tecnología::desde-espana-aparatos|Suplementos::desde-espana-salud|Piel::desde-espana-piel' | split: '|'
        assign es_handle = ''
        for m in es_map
          assign mp = m | split: '::'
          if parent_link.title == mp[0]
            assign es_handle = mp[1]
          endif
        endfor
        assign n_kr = 0
        assign n_es = 0
        assign n_ot = 0
        for l in parent_link.links
          if l.type == 'collection_link' and l.object.all_tags contains 'Envío: Corea'
            assign n_kr = n_kr | plus: 1
          endif
          if l.type == 'collection_link' and l.object.all_tags contains 'Envío: España'
            assign n_es = n_es | plus: 1
          endif
          unless l.object.all_tags contains 'Envío: Corea' or l.object.all_tags contains 'Envío: España'
            assign n_ot = n_ot | plus: 1
          endunless
        endfor
      -%}
      {%- comment -%} 18-10: cada producto sale una sola vez por desplegable (antes se repetía la misma foto) {%- endcomment -%}
      {%- assign usados = '' -%}
      <div class="msm__vis">
        <div class="msm__vmain">
          {%- if parent_link.title == 'Todo' -%}
            {%- liquid
              assign g_tit = 'Comprar por|Por origen|Especial Mirea|Te ayudamos' | split: '|'
              assign g_key = 'Todos los productos,Novedades,Más vendidos,Ofertas,Virales,packs|Desde Corea,Desde España,Perfumes árabes|Rituales,Seda,Aparatos,Tarjeta|Encuentra,Mirea AI,Guía,Foro' | split: '|'
            -%}
            <div class="msm__groups">
              {%- for gt in g_tit -%}
                {%- assign keys = g_key[forloop.index0] | split: ',' -%}
                <div class="msm__group">
                  <p class="msm__h">{{ gt }}</p>
                  <ul class="list-unstyled msm__vgrid msm__vgrid--sm">
                    {%- for l in parent_link.links -%}
                      {%- assign hit = false -%}
                      {%- for k in keys -%}{%- if l.title contains k -%}{%- assign hit = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
                      {%- if hit -%}{%- render 'mirea-mega-tile', l: l -%}{%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endfor -%}
            </div>
          {%- elsif parent_link.title == 'Más' -%}
            {%- comment -%} 17-10: "Más" es un cajón variado: rejilla simple, sin separar por origen {%- endcomment -%}
            <div class="msm__vhead"><p class="msm__h">Más secciones</p></div>
            <ul class="list-unstyled msm__vgrid">
              {%- for l in parent_link.links -%}{%- render 'mirea-mega-tile', l: l -%}{%- endfor -%}
            </ul>
          {%- elsif n_kr > 0 or n_es > 0 -%}
            {%- if n_kr > 0 -%}
              <div class="msm__row">
                <div class="msm__vhead"><p class="msm__h">{{ parent_link.title }} · Desde Corea</p><span class="msm__ship msm__ship--kr">🇰🇷 Original de Corea del Sur</span></div>
                <ul class="list-unstyled msm__vgrid">
                  {%- for l in parent_link.links -%}
                    {%- if l.type == 'collection_link' and l.object.all_tags contains 'Envío: Corea' -%}
                      {%- assign u = l.url | append: '/envio-corea' -%}
                      {%- assign img_t = blank -%}
                      {%- for p in l.object.products limit: 40 -%}
                        {%- if p.available and p.featured_image and p.tags contains 'Envío: Corea' -%}
                          {%- assign pid = p.id | prepend: '#' | append: '#' -%}
                          {%- unless usados contains pid -%}{%- assign img_t = p.featured_image -%}{%- assign usados = usados | append: pid -%}{%- break -%}{%- endunless -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- render 'mirea-mega-tile', l: l, url: u, origen: 'Envío: Corea', foto: img_t -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            {%- if n_es > 0 or es_handle != '' -%}
              <div class="msm__row">
                <div class="msm__vhead"><p class="msm__h">{{ parent_link.title }} · Desde España</p><span class="msm__ship">🚚 Envío rápido desde España</span></div>
                <ul class="list-unstyled msm__vgrid">
                  {%- for l in parent_link.links -%}
                    {%- if l.type == 'collection_link' and l.object.all_tags contains 'Envío: España' -%}
                      {%- assign u = l.url | append: '/envio-espana' -%}
                      {%- assign img_t = blank -%}
                      {%- for p in l.object.products limit: 40 -%}
                        {%- if p.available and p.featured_image and p.tags contains 'Envío: España' -%}
                          {%- assign pid = p.id | prepend: '#' | append: '#' -%}
                          {%- unless usados contains pid -%}{%- assign img_t = p.featured_image -%}{%- assign usados = usados | append: pid -%}{%- break -%}{%- endunless -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- render 'mirea-mega-tile', l: l, url: u, origen: 'Envío: España', foto: img_t -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if es_handle != '' and collections[es_handle].products_count > 0 -%}
                  <a class="msm__a msm__a--all" href="{{ collections[es_handle].url }}">Ver todo {{ parent_link.title | downcase }} desde España →</a>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if n_ot > 0 -%}
              <div class="msm__row">
                <div class="msm__vhead"><p class="msm__h">Más en {{ parent_link.title | downcase }}</p></div>
                <ul class="list-unstyled msm__vgrid">
                  {%- for l in parent_link.links -%}
                    {%- unless l.object.all_tags contains 'Envío: Corea' or l.object.all_tags contains 'Envío: España' -%}
                      {%- assign img_t = blank -%}
                      {%- for p in l.object.products limit: 40 -%}
                        {%- if p.available and p.featured_image -%}
                          {%- assign pid = p.id | prepend: '#' | append: '#' -%}
                          {%- unless usados contains pid -%}{%- assign img_t = p.featured_image -%}{%- assign usados = usados | append: pid -%}{%- break -%}{%- endunless -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- render 'mirea-mega-tile', l: l, foto: img_t -%}
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="msm__vhead"><p class="msm__h">{{ parent_link.title }}</p></div>
            <ul class="list-unstyled msm__vgrid">
              {%- for l in parent_link.links -%}{%- render 'mirea-mega-tile', l: l -%}{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- unless parent_link.title == 'Más' -%}
          <a class="msm__a msm__a--all" href="{{ parent_link.url }}">Ver todo {{ parent_link.title | downcase }} →</a>
          {%- endunless -%}
        </div>
        <div class="msm__promo">
          <a class="msm__card msm__card--dark" href="/pages/encuentra-tu-rutina">
            <span class="msm__eyebrow">Asesoría gratis</span>
            <span class="msm__title msm__title--sm">Encuentra tu rutina</span>
            <span class="msm__btn">Hacer el test</span>
          </a>
          <a class="msm__card" href="/collections/ofertas">
            <span class="msm__eyebrow">Ofertas</span>
            <span class="msm__title msm__title--sm">Precio especial</span>
            <span class="msm__txt">Rebajas mientras haya existencias.</span>
          </a>
        </div>
      </div>
    {%- elsif kind == 'espana' -%}
      <div class="msm__vis msm__vis--es">
        <div class="msm__vmain">
          <div class="msm__vhead">
            <p class="msm__h">Desde España · por categoría</p>
            <span class="msm__ship">🚚 Envío rápido desde España</span>
          </div>
          <ul class="list-unstyled msm__vgrid">
            {%- assign fotos_es = 'desde-espana-perfumes::good-girl|desde-espana-cofres-perfume::cofre-black-opium|desde-espana-piel::moisture-surge-100h-hidratante-autorrestaurador|desde-espana-cabello::rosemary-scalp-scaling-shampoo|desde-espana-cuerpo::eight-hour-intensive-moisture-body-treatment|desde-espana-maquillaje::almost-lipstick-black-honey|desde-espana-salud::mims-beauty|desde-espana-aparatos::medicube-age-r-booster-pro-pinklimited-version|desde-espana-sets::cofre-rutina-diaria-hydra-zen-lancome' | split: '|' -%}
            {%- assign es_list = 'desde-espana-perfumes::Perfumes|desde-espana-cofres-perfume::Cofres de perfume|desde-espana-piel::Piel|desde-espana-cabello::Cabello|desde-espana-cuerpo::Cuerpo|desde-espana-maquillaje::Maquillaje|desde-espana-salud::Salud y bienestar|desde-espana-aparatos::Aparatos|desde-espana-sets::Sets de regalo' | split: '|' -%}
            {%- for e in es_list -%}
              {%- assign ep = e | split: '::' -%}
              {%- assign ec = collections[ep[0]] -%}
              {%- if ec == blank or ec.products_count == 0 -%}{%- continue -%}{%- endif -%}
              {%- assign img = ec.image -%}
              {%- if img == blank -%}{%- for p in ec.products limit: 30 -%}{%- if p.available and p.featured_image -%}{%- assign img = p.featured_image -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
              {%- comment -%} 17-10: foto de un producto famoso elegido a mano para cada sección {%- endcomment -%}
              {%- for f in fotos_es -%}{%- assign fp = f | split: '::' -%}{%- if fp[0] == ep[0] and all_products[fp[1]].featured_image -%}{%- assign img = all_products[fp[1]].featured_image -%}{%- endif -%}{%- endfor -%}
              {%- assign img = img | default: ec.products.first.featured_image -%}
              <li><a class="msm__vtile" href="{{ ec.url }}"><span class="msm__vimg">{%- if img -%}{{ img | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: ep[1] }}{%- endif -%}</span><span class="msm__vname">{{ ep[1] }}</span></a></li>
            {%- endfor -%}
            {%- for l in parent_link.links -%}
              {%- comment -%} las secciones desde-espana-* ya salen arriba con su foto: no repetirlas {%- endcomment -%}
              {%- if l.object.handle contains 'desde-espana' -%}{%- continue -%}{%- endif -%}
              {%- render 'mirea-mega-tile', l: l -%}
            {%- endfor -%}
          </ul>
          <a class="msm__a msm__a--all" href="{{ parent_link.url }}">Ver todo desde España →</a>
        </div>
        {%- liquid
          assign es_col = collections['desde-espana']
          assign skip_v = 'Perfumerías Padilla|EMANAR BEAUTY|Mirea Skin|' | split: '|'
        -%}
        <div class="msm__vbrands">
          <p class="msm__h">Marcas desde España</p>
          <ul class="list-unstyled msm__chips">
            {%- assign n_v = 0 -%}
            {%- for v in es_col.all_vendors -%}
              {%- if skip_v contains v or v == blank -%}{%- continue -%}{%- endif -%}
              {%- assign n_v = n_v | plus: 1 -%}
              {%- if n_v > 48 -%}{%- break -%}{%- endif -%}
              <li><a class="msm__chip" href="{{ v | url_for_vendor }}">{{ v }}</a></li>
            {%- endfor -%}
          </ul>
          <a class="msm__a msm__a--all" href="{{ es_col.url }}">Ver todo desde España →</a>
        </div>
      </div>
    {%- else -%}
      <div class="msm__brands">
        <div class="msm__brands-head">
          <p class="msm__h">Marcas coreanas</p>
          {%- assign all_link = parent_link.links | first -%}
          <a class="msm__a msm__a--all" href="{{ parent_link.object.url | default: parent_link.url }}">{{ all_link.title | default: 'Ver todas las marcas →' }}</a>
        </div>
        <ul class="list-unstyled msm__bgrid">
          {%- for l in parent_link.links -%}
            {%- unless forloop.first -%}
              {%- liquid
                assign img = blank
                if l.object.image
                  assign img = l.object.image
                elsif l.object.products.first.featured_image
                  assign img = l.object.products.first.featured_image
                endif
              -%}
              <li>
                <a class="msm__brand" href="{{ l.object.url | default: l.url }}">
                  <span class="msm__bimg">{%- if img != blank -%}{{ img | image_url: width: 240 | image_tag: loading: 'lazy', alt: l.title }}{%- endif -%}</span>
                  <span class="msm__bname">{{ l.title }}</span>
                </a>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </li>
</ul>
<style>
  /* base.css trae reglas antiguas (.menu-list__submenu-inner .mega-menu__list en 3 columnas y .mega-menu a 880px) que estrechaban el panel: aquí se anulan con más especificidad */
  .menu-list__submenu-inner .mega-menu:has(.msm){flex:1 1 100%!important;width:100%!important;max-width:none!important;margin-inline:0!important}
  .menu-list__submenu-inner [data-menu-grid-id="{{ id }}"].mega-menu__grid{display:block!important;width:100%!important;max-width:none!important}
  .menu-list__submenu-inner .mega-menu__list.msm,.msm.msm{display:block!important;grid-template-columns:none!important;grid-column:1/-1!important;width:100%!important;max-width:1240px!important;min-width:0;margin:0 auto!important;box-sizing:border-box;padding:6px 0 10px!important;left:auto!important;transform:none!important}
  .msm.msm,.msm.msm *{white-space:normal!important}
  .msm.msm>.msm__inner{margin:0!important;padding:0!important;max-width:none!important}
  .msm .msm__inner{width:100%;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1.15fr) minmax(0,1fr) minmax(0,.95fr) minmax(0,1.3fr);gap:clamp(18px,2.6vw,40px);align-items:start}
  .msm__h{margin:0 0 14px;font-size:10.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#8f5d6c}
  .msm__list{display:flex;flex-direction:column;gap:7px;margin:0;padding:0}
  .msm__a{color:#1f191c;font-size:14px;line-height:1.35;text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .25s}
  .msm__a:hover{background-size:100% 1px}
  .msm__a--all{margin-top:6px;display:inline-block;font-weight:600;font-size:13px}
  .msm__list--img{gap:8px}
  .msm__ia{display:flex;align-items:center;gap:12px;color:#1f191c;font-size:14px;text-decoration:none}
  .msm__thumb{flex:0 0 44px;width:44px;height:44px;border-radius:50%;overflow:hidden;background:#ffffff;border:1px solid #eadcd8;display:block}
  .msm .msm__thumb img,.msm .msm__bimg img,.msm .msm__vimg img{margin:0!important;max-width:none!important}
  .msm__thumb img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
  .msm__ia:hover .msm__thumb img{transform:scale(1.1)}
  .msm__ia:hover span:last-child{text-decoration:underline;text-underline-offset:3px}
  .msm__promo{display:flex;flex-direction:column;gap:12px}
  .msm__card{min-width:0;display:flex;flex-direction:column;gap:6px;padding:20px 22px;background:#f6ece9;color:#1f191c;text-decoration:none;border-radius:4px;transition:transform .25s}
  .msm__card:hover{transform:translateY(-2px)}
  .msm__card--dark{background:#1f191c;color:#fff}
  .msm__eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#d7a9b6}
  .msm__card:not(.msm__card--dark) .msm__eyebrow{color:#8f5d6c}
  .msm__title{font-family:var(--mp-serif,Georgia,serif);font-size:28px;line-height:1.05;letter-spacing:-.02em}
  .msm__title--sm{font-size:22px}
  .msm__txt{font-size:12.5px;line-height:1.5;opacity:.85}
  .msm__btn{align-self:flex-start;margin-top:8px;padding:9px 16px;border:1px solid #fff;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .msm__card--dark:hover .msm__btn{background:#fff;color:#1f191c}
  .msm__brands{grid-column:1/-1}
  .msm__brands-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px}
  .msm__bgrid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:14px;margin:0;padding:0}
  .msm__brand{display:flex;flex-direction:column;gap:8px;color:#1f191c;text-decoration:none;text-align:center}
  .msm__bimg{aspect-ratio:1;border-radius:50%;overflow:hidden;background:#ffffff;border:1px solid #eadcd8;display:block}
  .msm__bimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
  .msm__brand:hover .msm__bimg img{transform:scale(1.08)}
  .msm__bname{font-size:12.5px;font-weight:600;line-height:1.25}
  /* 15-10 · menú visual */
  .msm .msm__inner--vis{display:block}
  .msm__vis{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:clamp(20px,3vw,44px);align-items:start}
  .msm__vis--es{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}
  .msm__vhead{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
  .msm__ship{font-size:12px;font-weight:600;color:#2f6b45;background:#eaf6ee;border-radius:999px;padding:4px 10px}
  .msm__vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:16px 14px;margin:0 0 10px;padding:0}
