<script>
(function(){
  var root=document.getElementById('mps-{{ section.id }}');
  if(!root||root.dataset.ready)return;root.dataset.ready='1';
  var track=root.querySelector('.mps__track'),dotsBox=root.querySelector('.mps__dots'),nav=root.querySelector('.mps__nav'),
      play=root.querySelector('.mps__play'),i=0,timer=null,slides,dots=[],n,
      ms=parseInt(root.dataset.intervalo,10)||5500,
      reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      userPaused=reduce,hover=false,focus=false,start=0;
  /* Vista previa de temporada: ?mirea_tema=halloween|black_friday|navidad|rebajas (solo cambia lo que se ve) */
  var tema=null;try{tema=new URLSearchParams(location.search).get('mirea_tema');}catch(e){}
  if(tema&&/^[a-z_]{3,20}$/.test(tema)){
    var tpl=root.querySelector('template.mps__tpl[data-tema="'+tema+'"]');
    if(tpl){track.insertBefore(tpl.content.cloneNode(true),track.firstChild);}
    else{var ya=track.querySelectorAll('.mps__slide');for(var q=0;q<ya.length;q++){if(ya[q].dataset.tema===tema){start=q;break;}}}
  }
  slides=track.querySelectorAll('.mps__slide');n=slides.length;
  for(var j=0;j<n;j++){slides[j].dataset.i=j;slides[j].setAttribute('aria-label',(j+1)+' de '+n);}
  if(n<2){if(nav)nav.hidden=true;if(slides[0]){slides[0].classList.add('is-active');slides[0].removeAttribute('inert');}return;}
  nav.hidden=false;
  for(var d=0;d<n;d++){(function(k){var b=document.createElement('button');b.type='button';b.className='mps__dot';
    b.setAttribute('aria-label','Ver banner '+(k+1)+' de '+n);b.appendChild(document.createElement('span'));
    b.addEventListener('click',function(){show(k);sync();});dotsBox.appendChild(b);dots.push(b);})(d);}
  function show(k){
    i=(k+n)%n;
    for(var j=0;j<n;j++){
      var on=j===i;
      slides[j].classList.toggle('is-active',on);
      if(on){slides[j].removeAttribute('inert');}else{slides[j].setAttribute('inert','');}
      dots[j].classList.toggle('is-active',on);if(on){dots[j].setAttribute('aria-current','true');}else{dots[j].removeAttribute('aria-current');}
      if(on){var img=slides[j].querySelector('img[loading="lazy"]');if(img)img.loading='eager';}
    }
    var nx=slides[(i+1)%n].querySelector('img[loading="lazy"]');if(nx)nx.loading='eager';
  }
  function stop(){if(timer){clearInterval(timer);timer=null;}}
  function sync(){stop();if(!userPaused&&!hover&&!focus&&!document.hidden){timer=setInterval(function(){show(i+1);},ms);}
    root.classList.toggle('is-paused',userPaused);
    if(play){play.setAttribute('aria-pressed',userPaused?'true':'false');play.setAttribute('aria-label',userPaused?'Reanudar el carrusel':'Pausar el carrusel');}}
  root.querySelector('.mps__prev').addEventListener('click',function(){show(i-1);sync();});
  root.querySelector('.mps__next').addEventListener('click',function(){show(i+1);sync();});
  if(play)play.addEventListener('click',function(){userPaused=!userPaused;sync();});
  root.addEventListener('mouseenter',function(){hover=true;sync();});
  root.addEventListener('mouseleave',function(){hover=false;sync();});
  root.addEventListener('focusin',function(){focus=true;sync();});
  root.addEventListener('focusout',function(e){if(!root.contains(e.relatedTarget)){focus=false;sync();}});
  root.addEventListener('keydown',function(e){if(e.key==='ArrowLeft'){show(i-1);sync();}else if(e.key==='ArrowRight'){show(i+1);sync();}});
  document.addEventListener('visibilitychange',sync);
  var x0=null,y0=0;
  root.addEventListener('touchstart',function(e){var t=e.touches[0];x0=t.clientX;y0=t.clientY;},{passive:true});
  root.addEventListener('touchend',function(e){if(x0===null)return;var t=e.changedTouches[0],dx=t.clientX-x0,dy=t.clientY-y0;x0=null;
    if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)){show(dx<0?i+1:i-1);sync();}},{passive:true});
  if(window.Shopify&&Shopify.designMode){document.addEventListener('shopify:block:select',function(e){var s=e.target.closest&&e.target.closest('.mps__slide');if(s&&root.contains(s)){show(parseInt(s.dataset.i,10));hover=true;sync();}});}
  show(start);sync();
})();
</script>
