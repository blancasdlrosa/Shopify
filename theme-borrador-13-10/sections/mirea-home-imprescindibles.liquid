{%- comment -%} 15-10 Mirea: antes "Imprescindibles"; ahora "Virales 🔥" (los más famosos). Fotos en blanco, sin marco. {%- endcomment -%}
<section class="mhi" id="mhi-{{ section.id }}">
  <div class="mhi__wrap">
    <div class="mhi__head">
      <div>
        <p class="mhi__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link | default: '/collections/virales-en-tiktok' }}" class="mhi__all">{{ section.settings.link_text }} →</a>
      {%- endif -%}
    </div>
    <div class="mhi__grid">
      {%- for p in section.settings.productos -%}
        <a class="mhi__card" href="{{ p.url }}">
          <div class="mhi__img">
            {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 990px) 25vw, 50vw' }}{%- endif -%}
            {%- if section.settings.etiqueta != blank -%}<span class="mhi__fire">{{ section.settings.etiqueta }}</span>{%- endif -%}
          </div>
          <p class="mhi__brand">{{ p.vendor }}</p>
          <p class="mhi__title">{{ p.title }}</p>
          <p class="mhi__price">{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</p>
          <span class="mhi__cta">Ver producto</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
#mhi-{{ section.id }}{background:#fff;padding:72px 0}
#mhi-{{ section.id }} .mhi__wrap{width:min(calc(100% - 40px),1180px);margin:0 auto}
#mhi-{{ section.id }} .mhi__head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}
#mhi-{{ section.id }} .mhi__eyebrow{margin:0 0 10px;color:#925b6d;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
#mhi-{{ section.id }} h2{margin:0;font-family:var(--font-heading--family);font-weight:400;font-size:clamp(34px,4.4vw,56px);line-height:1;letter-spacing:-.03em;color:#1f191c}
#mhi-{{ section.id }} .mhi__all{color:#1f191c;font-size:13px;font-weight:600;text-decoration:underline;text-underline-offset:4px;white-space:nowrap}
#mhi-{{ section.id }} .mhi__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px 20px}
#mhi-{{ section.id }} .mhi__card{position:relative;display:flex;flex-direction:column;color:#1f191c;text-decoration:none}
#mhi-{{ section.id }} .mhi__img{position:relative;aspect-ratio:4/5;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
#mhi-{{ section.id }} .mhi__img img{width:100%;height:100%;object-fit:contain;transition:transform .6s cubic-bezier(.2,.65,.3,1)}
#mhi-{{ section.id }} .mhi__card:hover .mhi__img img{transform:scale(1.05)}
#mhi-{{ section.id }} .mhi__fire{position:absolute;top:10px;left:10px;background:#1f191c;color:#fff;font-size:11px;font-weight:600;letter-spacing:.06em;padding:5px 10px;border-radius:999px}
#mhi-{{ section.id }} .mhi__brand{margin:14px 0 2px;color:#8f5d6c;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
#mhi-{{ section.id }} .mhi__title{margin:0;font-size:14px;line-height:1.4;min-height:2.8em}
#mhi-{{ section.id }} .mhi__price{margin:6px 0 10px;font-weight:600;font-size:14px}
#mhi-{{ section.id }} .mhi__price s{color:#715b63;font-weight:400;margin-left:4px}
#mhi-{{ section.id }} .mhi__cta{align-self:flex-start;padding:10px 16px;border:1px solid #1f191c;font-size:10.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;transition:background .2s,color .2s}
#mhi-{{ section.id }} .mhi__card:hover .mhi__cta{background:#1f191c;color:#fff}
@media(max-width:989px){#mhi-{{ section.id }} .mhi__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){#mhi-{{ section.id }}{padding:52px 0}#mhi-{{ section.id }} .mhi__wrap{width:calc(100% - 28px)}#mhi-{{ section.id }} .mhi__head{flex-direction:column;align-items:flex-start}#mhi-{{ section.id }} .mhi__cta{display:none}}
</style>
{% schema %}
{"name":"Mirea · Virales","settings":[
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Virales en TikTok 🔥"},
{"type":"text","id":"heading","label":"Título","default":"Los más famosos de la K-beauty."},
{"type":"text","id":"etiqueta","label":"Etiqueta en la foto","default":"🔥 Viral"},
{"type":"product_list","id":"productos","label":"Productos","limit":8},
{"type":"text","id":"link_text","label":"Texto enlace","default":"Ver todos los virales"},
{"type":"url","id":"link","label":"Enlace"}
]}
{% endschema %}
